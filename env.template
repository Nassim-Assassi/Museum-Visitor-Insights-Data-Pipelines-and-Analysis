# Static configuaration for AWS S3
ACCESS_KEY=${s3_access_key}
SECRET_ACCESS_KEY=${s3_secret_access_key}
BUCKET_NAME=${s3_bucket_name}

# Static configuration for APPACHE KAFKA
KAFKA_BOOTSTRAP_SERVERS=${kafka_bootstrap_servers}
KAFKA_SECURITY_PROTOCOL=${kafka_security_protocol}
KAFKA_SASL_MECHANISM=${kafka_sasl_mechanism}
KAFKA_SASL_USERNAME=${kafka_sasl_username}
KAFKA_SASL_PASSWORD=${kafka_sasl_password}
KAFKA_TOPIC=${kafka_topic}

# Dynamic configuration for AWS RDS (generated by Terraform)
DATABASE_HOST=${rds_hostname}
DATABASE_PORT=${rds_port}
DATABASE_USER=${rds_username}
DATABASE_PASSWORD=${rds_password}
DATABASE_DB=${rds_database_name}

# Dynamic configuration for AWS EC2 (generated by Terraform)
EC2_KEY_PAIR_NAME=${ec2_key_pair_name}
EC2_INSTANCE_PUBLIC_IP=${ec2_instance_public_ip}

